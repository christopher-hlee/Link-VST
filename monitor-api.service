[Unit]
Description=Restock Monitor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=platform
WorkingDirectory=/home/platform/restock-monitor
EnvironmentFile=/home/platform/restock-monitor/monitor/.env
ExecStart=/home/platform/restock-monitor/monitor/venv/bin/uvicorn monitor.main:app \
          --host 127.0.0.1 --port 8003
Restart=always
RestartSec=5

# Only reachable through Caddy on loopback, but narrow the blast radius anyway.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/platform/restock-monitor/monitor/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
