# Session login for the dashboard.
# Generate the hash ON THE SERVER with:  python -m monitor.hashpw
MONITOR_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# Optional Bearer key for programmatic /api access (mirrors LinkVST's LINK_API_KEY)
MONITOR_API_KEY=

# Telegram: create a bot via @BotFather, then message it once and call
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dead-man's switch. Create a check at https://healthchecks.io and paste its ping URL.
HEALTHCHECK_URL=

# Target RedSky public web key. Override if the default stops working.
TARGET_API_KEY=9f36aeafbe60771e321a7cc95a78140772ab3e96

# Best Buy developer API key (free): https://developer.bestbuy.com
BESTBUY_API_KEY=

# Scheduler
TICK_SECONDS=15
