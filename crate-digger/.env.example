# Copy to .env and edit. Every setting is also a CRATE_-prefixed env var.

# Where your records, loops and chops live.
# ~ and $VARS are expanded, and .env is read from the directory you run in.
CRATE_LIBRARY_DIR=~/CrateDigger

# A folder your DAW browser already watches. Exports land here.
#   Ableton: ~/Music/Ableton/User Library/Samples/  (or any folder you added
#            to the browser under Places)
#   Logic:   ~/Music/Audio Music Apps/Samples/
# CRATE_EXPORT_DIR=~/Documents/PROJECTS/samples

CRATE_HOST=127.0.0.1
CRATE_PORT=8770

# Refuse anything bigger than this, so a mis-tagged 400 MB radio transcription
# doesn't fill your disk.
CRATE_MAX_DOWNLOAD_MB=120
CRATE_HTTP_TIMEOUT=30

# Optional. Discogs is metadata only — labels, years, styles — for deciding
# what to hunt for. Free token: discogs.com/settings/developers
# CRATE_DISCOGS_TOKEN=

# Optional. Openverse works anonymously; a client id raises the rate limit.
# CRATE_OPENVERSE_CLIENT_ID=
# CRATE_OPENVERSE_CLIENT_SECRET=

# The local yt-dlp bridge, off by default. See docs/SOURCES.md before enabling.
# CRATE_ENABLE_RIPPER=false
# CRATE_RIPPER_BIN=yt-dlp
